{
  "name": "chipper-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Chipper — open community platform for microphysiological systems. REST API.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "local": "cross-env NODE_ENV=development nodemon src/server.js",
    "production": "cross-env NODE_ENV=production node src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "npm run local",
    "migrate": "cross-env NODE_ENV=development knex migrate:latest",
    "migrate:make": "cross-env NODE_ENV=development knex migrate:make",
    "migrate:rollback": "cross-env NODE_ENV=development knex migrate:rollback",
    "migrate:status": "cross-env NODE_ENV=development knex migrate:status",
    "migrate:fresh": "cross-env NODE_ENV=development knex migrate:rollback --all && cross-env NODE_ENV=development knex migrate:latest",
    "seed": "cross-env NODE_ENV=development knex seed:run",
    "seed:make": "cross-env NODE_ENV=development knex seed:make",
    "db:reset": "npm run migrate:fresh && npm run seed",
    "migrate:prod": "cross-env NODE_ENV=production knex migrate:latest",
    "migrate:prod:status": "cross-env NODE_ENV=production knex migrate:status",
    "seed:prod": "cross-env NODE_ENV=production knex seed:run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "chipper",
    "organ-on-chip",
    "microphysiological-systems",
    "express",
    "knex",
    "mysql"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.14",
    "sanitize-html": "2.13.0",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  }
}
