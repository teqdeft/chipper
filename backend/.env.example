# Copy to `.env` (local) or `.env.production` and fill in real values.
# `npm run local`      -> loads .env
# `npm run production` -> loads .env.production

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=Chipper
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chipper_dev
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_DEBUG=false

JWT_SECRET=chipper-jwt-key
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=chipper-jwt-refresh-key
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=chipper.org
JWT_AUDIENCE=chipper-web

BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_EXPIRES_MINUTES=60
EMAIL_VERIFY_EXPIRES_HOURS=48

CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=50
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=60
UPLOAD_RATE_LIMIT_MAX=100
EMAIL_RATE_LIMIT_WINDOW_MINUTES=60
EMAIL_RATE_LIMIT_MAX=30

UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/static/uploads
MAX_FILE_SIZE_MB=500
MAX_IMAGE_SIZE_MB=10
MAX_AVATAR_SIZE_MB=5
MAX_ATTACHMENT_SIZE_MB=25
MAX_FILES_PER_UPLOAD=20
ALLOWED_DESIGN_EXTENSIONS=stl,step,stp,iges,igs,3mf,obj,dxf,dwg,gcode,zip,pdf,json,csv,txt,md
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,txt,md

LOG_LEVEL=debug
LOG_DIR=logs
LOG_TO_FILE=true
LOG_MAX_FILES=14d

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Chipper
MAIL_FROM_ADDRESS=no-reply@chipper.org

FEATURE_COMMERCIAL=false
FEATURE_REGISTRATION_OPEN=true
FEATURE_REQUIRE_EMAIL_VERIFICATION=true
FEATURE_DESIGN_REVIEW_REQUIRED=true
